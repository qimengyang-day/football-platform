<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.football.mapper.PlayerInfoMapper">
    <select id="selectByUserId" parameterType="java.lang.Long" resultType="com.football.entity.PlayerInfo">
        SELECT * FROM player_info WHERE user_id = #{userId}
    </select>
</mapper>