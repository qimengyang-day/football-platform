<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.football.mapper.TeamClubMapper">
    <select id="selectByManagerId" parameterType="java.lang.Long" resultType="com.football.entity.TeamClub">
        SELECT * FROM team_club WHERE manager_id = #{managerId}
    </select>
</mapper>